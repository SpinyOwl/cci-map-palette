{
  "schemaVersion": 1,
  "id": "cci_map_palette",
  "version": "${version}",
  "name": "CCI Map Palette",
  "description": "Minimal Architectury-based mod scaffold for FTB Chunks runtime palette work.",
  "authors": [
    "Spinyowl"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.spinyowl.ccimap.fabric.CciMapPaletteFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": "${fabricapiversionrange}",
    "minecraft": "${mcversion}",
    "architectury": "${archversion}",
    "ftbchunks": "${ftbchunksversionrange}"
  },
  "mixins": [
    "cci_map_palette.mixins.json"
  ]
}
